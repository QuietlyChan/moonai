///|
struct AssetSpec {
  variable : String
  path : String
}

///|
fn write_text(builder : StringBuilder, value : String) -> Unit {
  builder.write_stringview(value[:])
}

///|
async fn append_asset(
  builder : StringBuilder,
  asset : AssetSpec,
  separator : Bool,
) -> Unit {
  let content = @fs.read_file(asset.path).text().replace_all(old="\r", new="")
  write_text(builder, "///|\nlet " + asset.variable + " : String =\n")
  for line in content.split("\n") {
    write_text(builder, "  #|" + line.to_owned() + "\n")
  }
  if separator {
    write_text(builder, "\n")
  }
}

///|
async fn main {
  let output = "examples/web_agent/backend/assets_generated.mbt"
  let assets = [
    {
      variable: "embedded_index_html",
      path: "examples/web_agent/frontend/index.html",
    },
    { variable: "embedded_app_js", path: "examples/web_agent/frontend/app.js" },
    {
      variable: "embedded_styles_css",
      path: "examples/web_agent/frontend/styles.css",
    },
  ]
  let builder = StringBuilder(size_hint=48_000)
  write_text(
    builder, "// Generated by `moon run examples/embed_assets`. Do not edit by hand.\n\n",
  )
  for index, asset in assets {
    append_asset(builder, asset, index < assets.length() - 1)
  }
  @fs.write_file(output, builder.to_string(), create_mode=CreateOrTruncate)
  println(
    "Embedded " + assets.length().to_string() + " frontend assets in " + output,
  )
}
