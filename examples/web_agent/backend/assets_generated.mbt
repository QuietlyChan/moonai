  #|  border-radius: 6px;
  #|}
  #|
  #|.activity-item[data-state="running"] {
  #|  border-left-color: var(--amber);
  #|}
  #|
  #|.activity-item[data-state="complete"] {
  #|  border-left-color: var(--green);
  #|}
  #|
  #|.activity-item[data-state="error"] {
  #|  border-left-color: var(--danger);
  #|}
  #|
  #|.activity-title {
  #|  display: flex;
  #|  align-items: center;
  #|  gap: 8px;
  #|}
  #|
  #|.activity-title svg {
  #|  width: 16px;
  #|  height: 16px;
  #|  color: var(--blue);
  #|}
  #|
  #|.activity-title strong {
  #|  min-width: 0;
  #|  flex: 1;
  #|  overflow-wrap: anywhere;
  #|  font-family: "JetBrains Mono", monospace;
  #|  font-size: 12px;
