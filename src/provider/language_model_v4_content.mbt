///|
/// Text generated by a V4 language model.
pub(all) struct LanguageModelV4Text {
  text : String
  provider_metadata : Map[String, Json]
} derive(Debug, Eq)

///|
/// Reasoning generated by a V4 language model.
pub(all) struct LanguageModelV4Reasoning {
  text : String
  provider_metadata : Map[String, Json]
} derive(Debug, Eq)

///|
/// File data returned by a V4 language model.
///
/// Providers may preserve either the original bytes or an existing Base64
/// representation. URLs remain references and are not downloaded implicitly.
pub(all) enum LanguageModelV4GeneratedFileData {
  V4GeneratedFileBase64(String)
  V4GeneratedFileBytes(Bytes)
  V4GeneratedFileUrl(String)
} derive(Debug, Eq)

///|
/// A file generated by a V4 language model.
pub(all) struct LanguageModelV4File {
  media_type : String
  data : LanguageModelV4GeneratedFileData
  provider_metadata : Map[String, Json]
} derive(Debug, Eq)

///|
/// A file generated as part of V4 model reasoning.
pub(all) struct LanguageModelV4ReasoningFile {
  media_type : String
  data : LanguageModelV4GeneratedFileData
  provider_metadata : Map[String, Json]
} derive(Debug, Eq)

///|
/// A source used by a V4 language model to generate its response.
pub(all) enum LanguageModelV4Source {
  V4UrlSource(
    id~ : String,
    url~ : String,
    title~ : String?,
    provider_metadata~ : Map[String, Json]
  )
  V4DocumentSource(
    id~ : String,
    media_type~ : String,
    title~ : String,
    filename~ : String?,
    provider_metadata~ : Map[String, Json]
  )
} derive(Debug, Eq)

///|
/// Provider-specific V4 content with no standardized representation.
pub(all) struct LanguageModelV4CustomContent {
  kind : String
  provider_metadata : Map[String, Json]
} derive(Debug, Eq)

///|
/// A complete tool call generated by a V4 language model.
pub(all) struct LanguageModelV4ToolCall {
  tool_call_id : String
  tool_name : String
  input : String
  provider_executed : Bool
  dynamic : Bool
  provider_metadata : Map[String, Json]
} derive(Debug, Eq)

///|
/// A provider-executed tool result returned by a V4 language model.
pub(all) struct LanguageModelV4ToolResult {
  tool_call_id : String
  tool_name : String
  result : Json
  is_error : Bool
  preliminary : Bool
  dynamic : Bool
  provider_metadata : Map[String, Json]
} derive(Debug, Eq)

///|
/// A provider tool approval request returned by a V4 language model.
pub(all) struct LanguageModelV4ToolApprovalRequest {
  approval_id : String
  tool_call_id : String
  provider_metadata : Map[String, Json]
} derive(Debug, Eq)

///|
/// Ordered content returned by a V4 language model.
///
/// This is deliberately independent from `GeneratedContent`, which remains
/// the normalized response shape used by legacy protocol adapters.
pub(all) enum LanguageModelV4Content {
  V4TextOutput(LanguageModelV4Text)
  V4ReasoningOutput(LanguageModelV4Reasoning)
  V4CustomOutput(LanguageModelV4CustomContent)
  V4ReasoningFileOutput(LanguageModelV4ReasoningFile)
  V4FileOutput(LanguageModelV4File)
  V4ToolApprovalRequestOutput(LanguageModelV4ToolApprovalRequest)
  V4SourceOutput(LanguageModelV4Source)
  V4ToolCallOutput(LanguageModelV4ToolCall)
  V4ToolResultOutput(LanguageModelV4ToolResult)
} derive(Debug, Eq)

///|
/// Construct generated V4 text content.
pub fn LanguageModelV4Content::text(
  text : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> LanguageModelV4Content {
  V4TextOutput({ text, provider_metadata })
}

///|
/// Construct generated V4 reasoning content.
pub fn LanguageModelV4Content::reasoning(
  text : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> LanguageModelV4Content {
  V4ReasoningOutput({ text, provider_metadata })
}

///|
/// Construct a generated V4 file content part.
pub fn LanguageModelV4Content::file(
  media_type~ : String,
  data~ : LanguageModelV4GeneratedFileData,
  provider_metadata? : Map[String, Json] = Map([]),
) -> LanguageModelV4Content {
  V4FileOutput({ media_type, data, provider_metadata })
}

///|
/// Construct a generated V4 reasoning-file content part.
pub fn LanguageModelV4Content::reasoning_file(
  media_type~ : String,
  data~ : LanguageModelV4GeneratedFileData,
  provider_metadata? : Map[String, Json] = Map([]),
) -> LanguageModelV4Content {
  V4ReasoningFileOutput({ media_type, data, provider_metadata })
}

///|
/// Construct a V4 URL source.
pub fn LanguageModelV4Content::url_source(
  id~ : String,
  url~ : String,
  title? : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> LanguageModelV4Content {
  V4SourceOutput(V4UrlSource(id~, url~, title~, provider_metadata~))
}

///|
/// Construct a V4 document source.
pub fn LanguageModelV4Content::document_source(
  id~ : String,
  media_type~ : String,
  title~ : String,
  filename? : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> LanguageModelV4Content {
  V4SourceOutput(
    V4DocumentSource(id~, media_type~, title~, filename~, provider_metadata~),
  )
}

///|
/// Construct a V4 tool-call content part.
pub fn LanguageModelV4Content::tool_call(
  value : LanguageModelV4ToolCall,
) -> LanguageModelV4Content {
  V4ToolCallOutput(value)
}

///|
/// Construct a V4 tool-result content part.
pub fn LanguageModelV4Content::tool_result(
  value : LanguageModelV4ToolResult,
) -> LanguageModelV4Content {
  V4ToolResultOutput(value)
}

///|
/// Construct a V4 tool-approval-request content part.
pub fn LanguageModelV4Content::tool_approval_request(
  value : LanguageModelV4ToolApprovalRequest,
) -> LanguageModelV4Content {
  V4ToolApprovalRequestOutput(value)
}

///|
/// Construct provider-specific V4 content.
pub fn LanguageModelV4Content::custom(
  kind~ : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> LanguageModelV4Content {
  V4CustomOutput({ kind, provider_metadata })
}

///|
/// Convert normalized generated file data at a legacy adapter boundary.
pub fn LanguageModelV4GeneratedFileData::from_generated_file_data(
  data : GeneratedFileData,
) -> LanguageModelV4GeneratedFileData {
  match data {
    GeneratedFileBase64(value) => V4GeneratedFileBase64(value)
    GeneratedFileUrl(value) => V4GeneratedFileUrl(value)
  }
}

///|
/// Convert V4 generated file data to the normalized legacy representation.
/// Raw bytes are Base64 encoded only when crossing this adapter boundary.
pub fn LanguageModelV4GeneratedFileData::to_generated_file_data(
  self : LanguageModelV4GeneratedFileData,
) -> GeneratedFileData {
  match self {
    V4GeneratedFileBase64(value) => GeneratedFileBase64(value)
    V4GeneratedFileBytes(value) => GeneratedFileBase64(@base64.encode(value))
    V4GeneratedFileUrl(value) => GeneratedFileUrl(value)
  }
}

///|
/// Convert a normalized generated file to the V4 file shape.
pub fn LanguageModelV4File::from_generated_file(
  file : GeneratedFile,
) -> LanguageModelV4File {
  {
    media_type: file.media_type,
    data: LanguageModelV4GeneratedFileData::from_generated_file_data(file.data),
    provider_metadata: copy_provider_metadata(file.provider_metadata),
  }
}

///|
/// Convert a V4 generated file to the normalized legacy shape.
pub fn LanguageModelV4File::to_generated_file(
  self : LanguageModelV4File,
) -> GeneratedFile {
  {
    media_type: self.media_type,
    data: self.data.to_generated_file_data(),
    provider_metadata: copy_provider_metadata(self.provider_metadata),
  }
}

///|
/// Convert a normalized generated file to the V4 reasoning-file shape.
pub fn LanguageModelV4ReasoningFile::from_generated_file(
  file : GeneratedFile,
) -> LanguageModelV4ReasoningFile {
  {
    media_type: file.media_type,
    data: LanguageModelV4GeneratedFileData::from_generated_file_data(file.data),
    provider_metadata: copy_provider_metadata(file.provider_metadata),
  }
}

///|
/// Convert a V4 reasoning file to the normalized legacy shape.
pub fn LanguageModelV4ReasoningFile::to_generated_file(
  self : LanguageModelV4ReasoningFile,
) -> GeneratedFile {
  {
    media_type: self.media_type,
    data: self.data.to_generated_file_data(),
    provider_metadata: copy_provider_metadata(self.provider_metadata),
  }
}

///|
/// Convert a normalized generated source to its V4 representation.
pub fn LanguageModelV4Source::from_generated_source(
  source : GeneratedSource,
) -> LanguageModelV4Source {
  match source {
    GeneratedUrlSource(id~, url~, title~, provider_metadata~) =>
      V4UrlSource(
        id~,
        url~,
        title~,
        provider_metadata=copy_provider_metadata(provider_metadata),
      )
    GeneratedDocumentSource(
      id~,
      media_type~,
      title~,
      filename~,
      provider_metadata~
    ) =>
      V4DocumentSource(
        id~,
        media_type~,
        title~,
        filename~,
        provider_metadata=copy_provider_metadata(provider_metadata),
      )
  }
}

///|
/// Convert a V4 generated source to the normalized legacy representation.
pub fn LanguageModelV4Source::to_generated_source(
  self : LanguageModelV4Source,
) -> GeneratedSource {
  match self {
    V4UrlSource(id~, url~, title~, provider_metadata~) =>
      GeneratedUrlSource(
        id~,
        url~,
        title~,
        provider_metadata=copy_provider_metadata(provider_metadata),
      )
    V4DocumentSource(id~, media_type~, title~, filename~, provider_metadata~) =>
      GeneratedDocumentSource(
        id~,
        media_type~,
        title~,
        filename~,
        provider_metadata=copy_provider_metadata(provider_metadata),
      )
  }
}

///|
/// Convert a normalized tool call to the V4 result representation.
pub fn LanguageModelV4ToolCall::from_tool_call(
  call : ToolCall,
) -> LanguageModelV4ToolCall {
  {
    tool_call_id: call.id,
    tool_name: call.name,
    input: call.arguments,
    provider_executed: call.provider_executed,
    dynamic: call.dynamic,
    provider_metadata: copy_provider_metadata(call.provider_metadata),
  }
}

///|
/// Convert a V4 tool call to the normalized legacy representation.
pub fn LanguageModelV4ToolCall::to_tool_call(
  self : LanguageModelV4ToolCall,
) -> ToolCall {
  ToolCall::new(
    id=self.tool_call_id,
    name=self.tool_name,
    arguments=self.input,
    provider_executed=self.provider_executed,
    dynamic=self.dynamic,
    provider_metadata=copy_provider_metadata(self.provider_metadata),
  )
}

///|
/// Convert a normalized provider tool result to its V4 representation.
pub fn LanguageModelV4ToolResult::from_tool_result(
  result : ToolResult,
) -> LanguageModelV4ToolResult {
  {
    tool_call_id: result.tool_call_id,
    tool_name: result.tool_name,
    result: result.result,
    is_error: result.is_error,
    preliminary: result.preliminary,
    dynamic: result.dynamic,
    provider_metadata: copy_provider_metadata(result.provider_metadata),
  }
}

///|
/// Convert a V4 provider tool result to the normalized legacy representation.
pub fn LanguageModelV4ToolResult::to_tool_result(
  self : LanguageModelV4ToolResult,
) -> ToolResult {
  ToolResult::new(
    tool_call_id=self.tool_call_id,
    tool_name=self.tool_name,
    result=self.result,
    is_error=self.is_error,
    preliminary=self.preliminary,
    dynamic=self.dynamic,
    provider_metadata=copy_provider_metadata(self.provider_metadata),
  )
}

///|
/// Convert a normalized approval request to its V4 representation.
pub fn LanguageModelV4ToolApprovalRequest::from_tool_approval_request(
  request : ToolApprovalRequest,
) -> LanguageModelV4ToolApprovalRequest {
  {
    approval_id: request.approval_id,
    tool_call_id: request.tool_call_id,
    provider_metadata: copy_provider_metadata(request.provider_metadata),
  }
}

///|
/// Convert a V4 approval request to the normalized legacy representation.
pub fn LanguageModelV4ToolApprovalRequest::to_tool_approval_request(
  self : LanguageModelV4ToolApprovalRequest,
) -> ToolApprovalRequest {
  ToolApprovalRequest::new(
    approval_id=self.approval_id,
    tool_call_id=self.tool_call_id,
    provider_metadata=copy_provider_metadata(self.provider_metadata),
  )
}

///|
/// Convert one normalized generated content part to the V4 contract.
pub fn LanguageModelV4Content::from_generated_content(
  content : GeneratedContent,
) -> LanguageModelV4Content {
  match content {
    GeneratedTextOutput(value) =>
      V4TextOutput({
        text: value.text,
        provider_metadata: copy_provider_metadata(value.provider_metadata),
      })
    GeneratedReasoningOutput(value) =>
      V4ReasoningOutput({
        text: value.text,
        provider_metadata: copy_provider_metadata(value.provider_metadata),
      })
    GeneratedCustomOutput(value) =>
      V4CustomOutput({
        kind: value.kind,
        provider_metadata: copy_provider_metadata(value.provider_metadata),
      })
    GeneratedReasoningFileOutput(value) =>
      V4ReasoningFileOutput(
        LanguageModelV4ReasoningFile::from_generated_file(value),
      )
    GeneratedFileOutput(value) =>
      V4FileOutput(LanguageModelV4File::from_generated_file(value))
    GeneratedToolApprovalRequestOutput(value) =>
      V4ToolApprovalRequestOutput(
        LanguageModelV4ToolApprovalRequest::from_tool_approval_request(value),
      )
    GeneratedSourceOutput(value) =>
      V4SourceOutput(LanguageModelV4Source::from_generated_source(value))
    GeneratedToolCallOutput(value) =>
      V4ToolCallOutput(LanguageModelV4ToolCall::from_tool_call(value))
    GeneratedToolResultOutput(value) =>
      V4ToolResultOutput(LanguageModelV4ToolResult::from_tool_result(value))
  }
}

///|
/// Convert one V4 content part to the normalized legacy response shape.
pub fn LanguageModelV4Content::to_generated_content(
  self : LanguageModelV4Content,
) -> GeneratedContent {
  match self {
    V4TextOutput(value) =>
      GeneratedContent::text(
        value.text,
        provider_metadata=copy_provider_metadata(value.provider_metadata),
      )
    V4ReasoningOutput(value) =>
      GeneratedContent::reasoning(
        value.text,
        provider_metadata=copy_provider_metadata(value.provider_metadata),
      )
    V4CustomOutput(value) =>
      GeneratedContent::custom(
        kind=value.kind,
        provider_metadata=copy_provider_metadata(value.provider_metadata),
      )
    V4ReasoningFileOutput(value) =>
      GeneratedReasoningFileOutput(value.to_generated_file())
    V4FileOutput(value) => GeneratedFileOutput(value.to_generated_file())
    V4ToolApprovalRequestOutput(value) =>
      GeneratedToolApprovalRequestOutput(value.to_tool_approval_request())
    V4SourceOutput(value) => GeneratedSourceOutput(value.to_generated_source())
    V4ToolCallOutput(value) => GeneratedToolCallOutput(value.to_tool_call())
    V4ToolResultOutput(value) =>
      GeneratedToolResultOutput(value.to_tool_result())
  }
}

///|
/// Convert normalized generated content to an independent V4 content array.
pub fn LanguageModelV4Content::from_generated_content_array(
  content : Array[GeneratedContent],
) -> Array[LanguageModelV4Content] {
  [
    for part in content => LanguageModelV4Content::from_generated_content(part)
  ]
}

///|
/// Convert a V4 content array at the normalized legacy response boundary.
pub fn LanguageModelV4Content::to_generated_content_array(
  content : Array[LanguageModelV4Content],
) -> Array[GeneratedContent] {
  [
    for part in content => part.to_generated_content()
  ]
}
