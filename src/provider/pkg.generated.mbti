  TranscriptionResponseMetadata(ResponseMetadata)
  TranscriptionFinish(text~ : String, segments~ : Array[TranscriptionSegment], language~ : String?, duration_seconds~ : Double?, provider_metadata~ : Map[String, Json])
  TranscriptionRaw(Json)
  TranscriptionStreamError(StreamErrorInfo)
} derive(Eq, @debug.Debug)

