// Type aliases
pub type BatchV4ModelId = String

pub type LanguageModelPrompt = Array[LanguageModelMessage]

// Traits
pub(open) trait AudioStream {
  async fn read_next(Self) -> AudioChunk?
  fn cancel(Self) -> Unit
}

pub(open) trait BatchV4 {
  fn specification_version(Self) -> String
  fn provider(Self) -> String
  fn supported_urls(Self) -> Array[SupportedUrlRule]
  async fn do_start_batch(Self, BatchV4StartOptions) -> BatchV4StartResult
  async fn do_get_batch_status(Self, BatchV4OperationOptions) -> BatchV4Status
  async fn do_get_batch_results(Self, BatchV4OperationOptions) -> Array[BatchV4ItemResult]
  async fn do_cancel_batch(Self, BatchV4OperationOptions) -> BatchV4CancelResult
  async fn do_list_batches(Self, BatchV4ListOptions) -> BatchV4ListResult
}

pub(open) trait ChatModel {
  fn provider(Self) -> String
  fn model_id(Self) -> String
  fn supported_urls(Self) -> Array[SupportedUrlRule]
  async fn generate(Self, ChatCallOptions) -> ChatResponse
  async fn stream(Self, ChatCallOptions, async (StreamEvent) -> Unit) -> ChatResponse
}

pub(open) trait CompletionModel {
  fn provider(Self) -> String
  fn model_id(Self) -> String
  async fn generate(Self, CompletionOptions) -> CompletionResponse
  async fn stream(Self, CompletionOptions, async (StreamEvent) -> Unit) -> CompletionResponse
}

pub(open) trait EmbeddingModelV4 {
  fn specification_version(Self) -> String
  fn provider(Self) -> String
  fn model_id(Self) -> String
  fn max_embeddings_per_call(Self) -> Int32?
  fn max_input_bytes_per_call(Self) -> Int64?
  fn supports_parallel_calls(Self) -> Bool
  async fn do_embed(Self, EmbeddingModelV4CallOptions) -> EmbeddingModelV4Result
}

pub(open) trait EmbeddingWireModel {
  fn provider(Self) -> String
  fn model_id(Self) -> String
  fn max_embeddings_per_call(Self) -> Int32
  fn supports_parallel_calls(Self) -> Bool
  async fn embed(Self, Array[String], EmbeddingOptions) -> EmbeddingBatchResponse
}

pub(open) trait FilesV4 {
  fn specification_version(Self) -> String
  fn provider(Self) -> String
  async fn upload_file(Self, FilesV4UploadFileCallOptions) -> FilesV4UploadFileResult
  async fn get_file_metadata(Self, FilesV4GetFileMetadataCallOptions) -> FilesV4FileMetadata
  async fn download_file(Self, FilesV4DownloadFileCallOptions) -> FilesV4DownloadFileResult
  async fn delete_file(Self, FilesV4DeleteFileCallOptions) -> FilesV4DeleteFileResult
}

pub(open) trait ImageModelV4 {
  fn specification_version(Self) -> String
  fn provider(Self) -> String
  fn model_id(Self) -> String
