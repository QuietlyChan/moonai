///|
/// Text generated by a language model.
#derive(Debug, Eq)
pub(all) struct GeneratedText {
  text : String
  provider_metadata : Map[String, Json]
}

///|
/// Reasoning generated by a language model.
#derive(Debug, Eq)
pub(all) struct GeneratedReasoning {
  text : String
  provider_metadata : Map[String, Json]
}

///|
/// Data returned for a generated file.
#derive(Debug, Eq)
pub(all) enum GeneratedFileData {
  GeneratedFileBase64(String)
  GeneratedFileUrl(String)
}

///|
/// A file generated by a language model.
#derive(Debug, Eq)
pub(all) struct GeneratedFile {
  media_type : String
  data : GeneratedFileData
  provider_metadata : Map[String, Json]
}

///|
/// A source used to generate the response.
#derive(Debug, Eq)
pub(all) enum GeneratedSource {
  GeneratedUrlSource(
    id~ : String,
    url~ : String,
    title~ : String?,
    provider_metadata~ : Map[String, Json]
  )
  GeneratedDocumentSource(
    id~ : String,
    media_type~ : String,
    title~ : String,
    filename~ : String?,
    provider_metadata~ : Map[String, Json]
  )
}

///|
/// Provider-specific generated content that has no standard representation.
#derive(Debug, Eq)
pub(all) struct GeneratedCustomContent {
  kind : String
  provider_metadata : Map[String, Json]
}

///|
/// Construct provider-specific generated content that has no shared wire
/// representation. Providers use this for forward-compatible response
/// blocks while retaining the raw payload in provider metadata.
pub fn GeneratedCustomContent::new(
  kind~ : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> GeneratedCustomContent {
  { kind, provider_metadata, }
}

///|
/// Ordered content returned by a language model.
#derive(Debug, Eq)
pub(all) enum GeneratedContent {
  GeneratedTextOutput(GeneratedText)
  GeneratedReasoningOutput(GeneratedReasoning)
  GeneratedFileOutput(GeneratedFile)
  GeneratedReasoningFileOutput(GeneratedFile)
  GeneratedSourceOutput(GeneratedSource)
  GeneratedToolCallOutput(ToolCall)
  GeneratedToolResultOutput(ToolResult)
  GeneratedToolApprovalRequestOutput(ToolApprovalRequest)
  GeneratedCustomOutput(GeneratedCustomContent)
}

///|
/// Construct generated text content.
pub fn GeneratedContent::text(
  text : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> GeneratedContent {
  GeneratedTextOutput({ text, provider_metadata, })
}

///|
/// Construct generated reasoning content.
pub fn GeneratedContent::reasoning(
  text : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> GeneratedContent {
  GeneratedReasoningOutput({ text, provider_metadata, })
}

///|
/// Construct a generated file content part.
pub fn GeneratedContent::file(
  media_type~ : String,
  data~ : GeneratedFileData,
  provider_metadata? : Map[String, Json] = Map([]),
) -> GeneratedContent {
  GeneratedFileOutput({ media_type, data, provider_metadata, })
}

///|
/// Construct a generated reasoning file content part.
pub fn GeneratedContent::reasoning_file(
  media_type~ : String,
  data~ : GeneratedFileData,
  provider_metadata? : Map[String, Json] = Map([]),
) -> GeneratedContent {
  GeneratedReasoningFileOutput({ media_type, data, provider_metadata, })
}

///|
/// Construct a URL source.
pub fn GeneratedContent::url_source(
  id~ : String,
  url~ : String,
  title? : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> GeneratedContent {
  GeneratedSourceOutput(
    GeneratedUrlSource(id~, url~, title~, provider_metadata~),
  )
}

///|
/// Construct a document source.
pub fn GeneratedContent::document_source(
  id~ : String,
  media_type~ : String,
  title~ : String,
  filename? : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> GeneratedContent {
  GeneratedSourceOutput(
    GeneratedDocumentSource(
      id~,
      media_type~,
      title~,
      filename~,
      provider_metadata~,
    ),
  )
}

///|
/// Construct generated tool-call content.
pub fn GeneratedContent::tool_call(value : ToolCall) -> GeneratedContent {
  GeneratedToolCallOutput(value)
}

///|
/// Construct provider-executed tool-result content.
pub fn GeneratedContent::tool_result(value : ToolResult) -> GeneratedContent {
  GeneratedToolResultOutput(value)
}

///|
/// Construct provider tool approval content.
pub fn GeneratedContent::tool_approval_request(
  value : ToolApprovalRequest,
) -> GeneratedContent {
  GeneratedToolApprovalRequestOutput(value)
}

///|
/// Construct provider-specific content.
pub fn GeneratedContent::custom(
  kind~ : String,
  provider_metadata? : Map[String, Json] = Map([]),
) -> GeneratedContent {
  GeneratedCustomOutput({ kind, provider_metadata, })
}

///|
pub extend GeneratedText with Debug::{to_repr}

///|
pub extend GeneratedText with Eq::{not_equal, equal}

///|
pub extend GeneratedReasoning with Debug::{to_repr}

///|
pub extend GeneratedReasoning with Eq::{not_equal, equal}

///|
pub extend GeneratedFileData with Debug::{to_repr}

///|
pub extend GeneratedFileData with Eq::{not_equal, equal}

///|
pub extend GeneratedFile with Debug::{to_repr}

///|
pub extend GeneratedFile with Eq::{not_equal, equal}

///|
pub extend GeneratedSource with Debug::{to_repr}

///|
pub extend GeneratedSource with Eq::{not_equal, equal}

///|
pub extend GeneratedCustomContent with Debug::{to_repr}

///|
pub extend GeneratedCustomContent with Eq::{not_equal, equal}

///|
pub extend GeneratedContent with Debug::{to_repr}

///|
pub extend GeneratedContent with Eq::{not_equal, equal}
