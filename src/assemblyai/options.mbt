///|
/// AssemblyAI transcription model ids, e.g. `universal-3-pro`,
/// `universal-2`, `best`, `nano`.
pub type AssemblyAITranscriptionModelId = String

///|
/// Provider options accepted under the `assemblyai` namespace (all optional,
/// snake_case wire names as given): `language_code`, `punctuate`,
/// `format_text`, `speech_model` override, `poll_interval_ms`,
/// `poll_timeout_ms`.
