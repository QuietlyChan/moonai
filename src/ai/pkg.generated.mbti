// Errors
pub suberror NoObjectGeneratedError {
  NoObjectGeneratedError(message~ : String, text~ : String?, response~ : @generate_text.GenerateTextResult, failure~ : ObjectGenerationFailure)
} derive(@debug.Debug)

pub suberror ObjectValidationError {
  ObjectValidationError(path~ : String, message~ : String)
} derive(Eq, @debug.Debug)

// Types and methods
pub(all) enum ObjectGenerationFailure {
  EmptyResponse
  InvalidJson(message~ : String)
  SchemaMismatch(path~ : String, message~ : String)
} derive(Eq, @debug.Debug)

pub(all) struct ObjectResponse {
  object : Json
  response : @generate_text.GenerateTextResult
} derive(@debug.Debug)

pub(all) struct RerankItem {
  original_index : Int
  score : Double
  document : RerankingDocument
} derive(Eq, @debug.Debug)

pub(all) struct RerankResult {
  original_documents : @provider.RerankingModelV4Documents
  reranked_documents : @provider.RerankingModelV4Documents
  ranking : Array[RerankItem]
  response : @provider.ResponseMetadata
  provider_metadata : Map[String, Json]
} derive(Eq, @debug.Debug)

pub(all) enum RerankingDocument {
  TextDocument(String)
  ObjectDocument(Json)
} derive(Eq, @debug.Debug)

