// Traits
pub(open) trait HttpStreamResponse {
  fn status_code(Self) -> Int
  fn reason(Self) -> String
  fn headers(Self) -> Map[String, String]
  async fn read_until(Self, String) -> String?
  async fn read_all(Self) -> Bytes
  fn close(Self) -> Unit
}

pub(open) trait HttpTransport {
  async fn fetch(Self, HttpRequest) -> HttpResponse
  async fn fetch_stream(Self, HttpRequest) -> &HttpStreamResponse
}

pub(open) trait WebSocketConnection {
  async fn send_text(Self, String) -> Unit
  async fn send_binary(Self, Bytes) -> Unit
  async fn receive(Self) -> WebSocketReceive
  async fn send_close(Self, Int, String?) -> Unit
  fn close(Self) -> Unit
}

pub(open) trait WebSocketConnector {
  async fn connect(Self, String, Array[String], Map[String, String]) -> &WebSocketConnection
}

